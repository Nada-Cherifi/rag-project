{
  "realm": "rag",
  "enabled": true,
  "displayName": "Orange",
  "loginTheme": "orange",
  "internationalizationEnabled": true,
  "supportedLocales": ["fr", "en", "ar"],
  "defaultLocale": "fr",
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Utilisateur de l'application RAG"
      },
      {
        "name": "ADMIN",
        "description": "Administrateur de l'application RAG"
      }
    ]
  },
  "clients": [
    {
      "clientId": "rag-client",
      "name": "RAG Client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "rootUrl": "http://localhost:4200",
      "baseUrl": "http://localhost:4200",
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:4200/*",
        "pkce.code.challenge.method": "S256"
      },
      "protocol": "openid-connect"
    }
  ]
}
